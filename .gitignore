# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (large binaries — track via git-lfs or release assets if needed)
models/*.bin
models/*.pt
models/*.safetensors
models/*.onnx
!models/.gitkeep

# Generated predictions
data/output/*.json
!data/output/.gitkeep

# Bài nộp — dẫn xuất, luôn sinh lại được bằng `smk solve --zip`
data/submission/

# KB pipeline — dữ liệu dẫn xuất, luôn build lại được từ nguồn thô
data/staging/*
!data/staging/.gitkeep
data/artifacts/*
!data/artifacts/.gitkeep

# Cache model của HuggingFace (Phase 5) — tải một lần, không vào git
.cache/
models/hf/

# Test / lint cache
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/


data/knowledge_base/icd
data/knowledge_base/rxnorm
data/knowledge_base/snomed
data/knowledge_base/atc

# Corpus sinh ra — PHÁI SINH, tái tạo bằng một lệnh:
#     smk synth build -n 500
# Cùng quy ước với `data/artifacts/*` (KB 311 MB): nguồn thì commit, thứ dựng ra
# từ nguồn thì không. Tái lập bảo đảm bằng seed ghim + `corpus_sha256` trong
# manifest + `.sha256` của các file `data/curated/`.
# Giữ lại `manifest.json` và `splits.json` — chúng là HỒ SƠ nguồn gốc, không
# phải dữ liệu, và Phase 3 cần `splits.json` để chọn epoch.
data/synth/*/text/
data/synth/*/annotations/

# Checkpoint tagger (Phase 3) — ~1,1 GB. Đóng gói riêng khi nộp bài, không vào
# git. Tái lập: seed + revision base model + corpus_sha256 đều ghim trong
# `smk_meta.json`.
data/artifacts/tagger/
