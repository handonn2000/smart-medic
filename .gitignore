# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts.
#
# Training checkpoints stay OUT of the repo — they are a development-time
# intermediate and are large.
models/*.bin
models/*.pt
models/*.safetensors
models/**/checkpoint-*/

# But the SHIPPED inference artifacts must be IN the repo. NFR1 (BTC phải cài
# lại được từ máy sạch) là ràng buộc cứng nhất: không cài được = bị loại, tức
# mất trắng chứ không phải mất điểm. Tải weights lúc runtime đã có tiền lệ vỡ
# (xem PRD tab 04 §6 — SapBERT cần SOCKS proxy, ba domain, sai tokenizer).
#
# git-lfs cũng bị loại vì cùng lý do: nó thêm một bước cài đặt nữa có thể hỏng
# trên máy BTC. Commit thẳng file .onnx đã lượng tử hóa int8 — repo nặng hơn,
# nhưng đó là đánh đổi ĐÚNG chiều: nặng repo là chi phí, không cài được là
# mất trắng. Xem system-design §9 (đánh đổi #8) — cùng lập luận đã dùng cho KB.
!models/*.onnx
# Exclude ner.onnx specifically as it exceeds GitHub's 100MB limit (1GB)
models/ner.onnx
!models/tokenizer.json
!models/MANIFEST.json
!models/.gitkeep

# Generated predictions
data/output/*.json
!data/output/.gitkeep

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/

# KB build artifacts are versioned so v2 can run on a clean machine without
# redistributing the much larger raw RxNorm release.
data/output.zip
data/v3_3_variants/

# dữ liệu ngoài: parquet gốc không commit (396 MB), file .jsonl đã lọc thì commit
data/external/raw/
