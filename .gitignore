# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (large binaries — track via git-lfs or release assets if needed)
models/*.bin
models/*.pt
models/*.safetensors
models/*.onnx
!models/.gitkeep

# Generated predictions
data/output/*.json
!data/output/.gitkeep

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/

# KB build artifacts are versioned so v2 can run on a clean machine without
# redistributing the much larger raw RxNorm release.
data/output.zip
data/v3_3_variants/
data/v4_medication_variants/

# Curation data can contain clinical context or licensed source material.
# Track only the contracts/placeholders; generated Bronze/Silver/Gold stays local.
data/curation/bronze/**
data/curation/silver/**
data/curation/gold/**
!data/curation/bronze/.gitkeep
!data/curation/silver/.gitkeep
!data/curation/gold/.gitkeep
data/sources/dav/**
!data/sources/dav/README.md
!data/sources/dav/drug_aliases.template.csv
