# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (large binaries — track via git-lfs or release assets if needed)
models/*.bin
models/*.pt
models/*.safetensors
models/*.onnx
!models/.gitkeep

# Generated predictions
data/output/*.json
!data/output/.gitkeep

# Generated annotation-QA artifacts
/remaining.txt
/scripts/annotation_qa/packets/
/scripts/annotation_qa/*.pkl
/scripts/annotation_qa/scd_changes.json

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/

# datasource — the raw UMLS/RxNorm drops are 660 MB and licence-gated, so they
# stay out. The ONE derived file inference reads is tracked below: without it a
# clean checkout raises ConfigError on the first drug span, which under PRD §5
# ("nếu BTC không cài đặt lại được source code của nhóm → nhóm thi sẽ bị loại")
# is a disqualification, not an inconvenience.
/data/knowledge_base
!/data/knowledge_base/ICD10.csv
!/data/knowledge_base/brand_to_ingredient.json
# 1.7 MB, and it is a correctness check, not a nicety: a retired RxCUI scores 0
# and is indistinguishable from a correct one in the output.
!/data/knowledge_base/RXNCUI.RRF

# Immutable run records — regenerable from pinned code + config
runs/*
!runs/.gitkeep
!runs/README.md
# ...except the pinned leverage map — it is a reference artifact the plan cites,
# not a per-run output. Regenerate with scripts/analysis/leverage_map.py
!runs/leverage_map.json

# Built indexes / caches. "Regenerable" was true and beside the point: the
# rebuild (`make index`) needs the 660 MB licence-gated RRF drops, which the
# organisers will not have — so the four files below are tracked, 11 MB
# together, and they are the difference between a submission that runs on a
# clean checkout and one that does not.
data/artifacts/
# Opened by the inference path — verified by instrumenting `open` over a full
# run (tests/test_reproducibility.py does this on every suite run).
!data/artifacts/gazetteer.json
!data/artifacts/kb_codes.json
!data/artifacts/edge_index.json
# NOT read at inference: scripts/submit/package_submission.py reads it to record
# KB versions in the run manifest. Tracked so `make submit` works from a clean
# checkout too, which is a different requirement from the three above.
!data/artifacts/kb_hashes.json

# The submission archive. Rebuild with `make submit`; the authoritative copy
# lives in runs/<ts>_<sha>/output.zip alongside the manifest that explains it.
/output.zip
