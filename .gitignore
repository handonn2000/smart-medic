# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Model artifacts (large binaries — track via git-lfs or release assets if needed)
models/*.bin
models/*.pt
models/*.safetensors
models/*.onnx
!models/.gitkeep

# Generated predictions
data/output/*.json
!data/output/.gitkeep

# Generated annotation-QA artifacts
/remaining.txt
/scripts/annotation_qa/packets/
/scripts/annotation_qa/*.pkl
/scripts/annotation_qa/scd_changes.json

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
.idea/
.vscode/

# datasource
/data/knowledge_base

# Immutable run records — regenerable from pinned code + config
runs/*
!runs/.gitkeep
!runs/README.md
# ...except the pinned leverage map — it is a reference artifact the plan cites,
# not a per-run output. Regenerate with scripts/analysis/leverage_map.py
!runs/leverage_map.json

# Built indexes / caches — regenerable
data/artifacts/

# The submission archive. Rebuild with `make submit`; the authoritative copy
# lives in runs/<ts>_<sha>/output.zip alongside the manifest that explains it.
/output.zip
